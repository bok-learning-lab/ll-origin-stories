# Copy this file to .env at the ll-origin-stories repository root.
# Fill only the providers you use. --dry-run needs no key.
# Never commit or distribute the populated .env.

OPENROUTER_API_KEY=

# Use the full fal key exactly as supplied, including any colon.
FAL_API_KEY=

# One Harvard API Portal key is shared by all three HUIT services.
HUIT_API_KEY=

# The following base URLs are constants in utils/lib/providers.mjs.
# They are documented here, NOT configurable environment variables:
# huit-openai: https://apis.huit.harvard.edu/ais-openai-direct/v2
# huit-gemini: https://apis.huit.harvard.edu/ais-google-gemini
# huit-bedrock: https://apis.huit.harvard.edu/ais-bedrock-llm
# OpenAI/Gemini use api-key; Bedrock uses x-api-key, all with HUIT_API_KEY.

# Choose each model explicitly with --model.
# To select a different credential file, pass --env-file /path/to/.env.
# To select another root, pass --project-root /path/to/project.
